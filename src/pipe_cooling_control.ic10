define Kelvin 273.15
define maxPressure 3000

alias analyzer d0
alias valve d1
alias memory d2

alias current r0
alias target r1
alias on r2
alias pressure r3
alias safe r4
alias heat r5

Start:
yield

l current analyzer Temperature
l pressure analyzer Pressure
sub current current Kelvin
l target memory Setting

slt safe pressure maxPressure

sgt heat current target
and on heat safe
s valve On on

j Start