define housing -128473777
define button 1462769197
define switch 1773255945
define displaySmall -2041948072
define INVALID 361

define buttonUtility HASH("Utility")
define buttonBasic HASH("Basic")
define buttonMedium HASH("Medium")
define buttonLarge HASH("Large")
define buttonExotic HASH("Exotic")
define dishMedium HASH("Medium Dish")
define dishLarge HASH("Large Dish")

# constants
define ModeDegrees 16
define ModeString 10

alias receiver r0
alias index r1
alias address r2
alias horizontal r3
alias vertical r4
alias buttonName r5
alias buttonRef r6
alias color r7
alias value r8
alias dish r9
alias dishName r15
alias dishType r14

# Find receiver housing
lbn receiver housing HASH("Receiver") ReferenceId Maximum
sbn displaySmall HASH("HorizontalActual") Mode ModeDegrees
sbn displaySmall HASH("VerticalActual") Mode ModeDegrees
sbn displaySmall HASH("HorizontalRequired") Mode ModeDegrees
sbn displaySmall HASH("VerticalRequired") Mode ModeDegrees

start:
  yield

  lbn value 439026183 dishMedium On Average
  select color value  Color.Green Color.Red
  sbn button dishMedium Color color

  lbn value 1913391845 dishLarge On Average
  select color value  Color.Green Color.Red
  sbn button dishLarge Color color

  lbn value switch HASH("Select Dish") On Average
  select dishType value 439026183 1913391845
  select dishName value dishMedium dishLarge
  lbn dish dishType dishName ReferenceId Maximum
  l value dish Horizontal
  sbn displaySmall HASH("HorizontalActual") Setting value
  l value dish Vertical
  sbn displaySmall HASH("VerticalActual") Setting value

  move index 0
  loop:
    mul address index 2
    get horizontal receiver address
    add address address 1
    get vertical receiver address
    seq value horizontal INVALID
    select color value Color.Yellow Color.Green

    move buttonName buttonUtility
    beq index 0 updateButton
    move buttonName buttonBasic
    beq index 1 updateButton
    move buttonName buttonMedium
    beq index 2 updateButton
    move buttonName buttonLarge
    beq index 3 updateButton
    move buttonName buttonExotic
    beq index 4 updateButton
    updateButton:
    sbn button buttonName Color color
    
    add index index 1
    blt index 5 loop
j start
