define button 1462769197
define housing -128473777
define mediumDish 439026183
define largeDish 1913391845

alias active r0
alias latched r1
alias horizontal r2
alias vertical r3
alias address r4
alias receiverRef r5
alias dishRef r6

# Resolve devices once
lbn receiverRef housing HASH("Receiver") ReferenceId Maximum
lbn r7 mediumDish HASH("Medium Dish") ReferenceId Maximum
lbn r8 largeDish HASH("Large Dish") ReferenceId Maximum

main:
  yield

  # Check buttons in priority order
  move address 0
  move dishRef r7
  lbn active button HASH("Utility") Activate Average
  bgtz active transfer

  move address 2
  move dishRef r7
  lbn active button HASH("Basic") Activate Average
  bgtz active transfer

  move address 4
  move dishRef r7
  lbn active button HASH("Medium") Activate Average
  bgtz active transfer

  move address 6
  move dishRef r8
  lbn active button HASH("Large") Activate Average
  bgtz active transfer

  move address 8
  move dishRef r8
  lbn active button HASH("Exotic") Activate Average
  bgtz active transfer

  move latched -1

  j main

transfer:
  # Latch immediately, preventing repeated transfers
  beq latched address main
  move latched address

  # Read coordinates
  get horizontal receiverRef address
  add address address 1
  get vertical receiverRef address

  # Don't transfer invalid coordinates
  beq horizontal 361 main
  beq vertical 361 main

  # Transfer coordinates to communication dish
  s dishRef Horizontal horizontal
  s dishRef Vertical vertical

  j main
