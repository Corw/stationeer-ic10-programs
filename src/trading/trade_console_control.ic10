define button 1462769197
define housing -128473777

alias active r0
alias latched r1
alias horizontal r2
alias vertical r3
alias address r4
alias receiverRef r5
alias dishRef r6
alias name r7
alias mediumDish r15
alias largeDish r14
alias value r13

# Resolve devices once
lbn receiverRef housing HASH("Receiver") ReferenceId Maximum
lbn mediumDish 439026183 HASH("Medium Dish") ReferenceId Maximum
lbn largeDish 1913391845 HASH("Large Dish") ReferenceId Maximum

main:
  yield

  # Check buttons in priority order
  move address 0
  move dishRef mediumDish
  move name HASH("Utility")
  lbn active button name Activate Average
  bgtz active transfer

  move address 2
  move dishRef mediumDish
  move name HASH("Basic")
  lbn active button name Activate Average
  bgtz active transfer

  move address 4
  move dishRef mediumDish
  move name HASH("Medium")
  lbn active button name Activate Average
  bgtz active transfer

  move address 6
  move dishRef largeDish
  move name HASH("Large")
  lbn active button name Activate Average
  bgtz active transfer

  move address 8
  move dishRef largeDish
  move name HASH("Exotic")
  lbn active button name Activate Average
  bgtz active transfer

  move name HASH("Medium Dish")
  move dishRef mediumDish
  lbn active button name Activate Average
  bgtz active toggleDish

  move name HASH("Large Dish")
  move dishRef largeDish
  lbn active button name Activate Average
  bgtz active toggleDish

  move latched -1

  j main

transfer:
  jal latch

  # Read coordinates
  get horizontal receiverRef address
  add address address 1
  get vertical receiverRef address

  # Don't transfer invalid coordinates
  beq horizontal 361 main
  beq vertical 361 main

  # Transfer coordinates to communication dish
  s dishRef Horizontal horizontal
  s dishRef Vertical vertical

  j main
toggleDish:
  jal latch
  l value dishRef On
  select value value 0 1
  s dishRef On value
  j main
latch:
  beq latched name main
  move latched name
  j ra
