alias harv d0
alias seedSupply d2
alias buff r0
alias val r1
alias program r10
alias stateHand r11
alias statePosition r12
alias statePlant r13
alias moveSetting r14
define CooHome 0
define CooUnloader 1
define CooLoader 2
define ProgHarvestPlant 0
define ProgHarvestSeed 1
define ProgSeed 2
define AtHome 0
define AtUnloader 1
define AtLoader 2
define AtField 3
define AtEnd 4
define PlantNone 10
define PlantGrowing 20
define PlantMatureSeed 30
define PlantMature 40
define PlantDead 50
define ItemEmpty 0
define ItemOccupied 100
define ItemFull 200
define JobPlant 100
define JobHarvestSeed 200
move program ProgHarvestPlant
Start:
jal WaitIdle
l statePosition d3 Setting
l statePlant d4 Setting
l stateHand d5 Setting
beq statePosition AtHome SwitchProgramAndMoveNext
beq statePosition AtField DoFieldWork
beq statePosition AtUnloader DoUnload
beq statePosition AtLoader DoLoad
MoveNext:
beqal program ProgHarvestPlant 
s harv Setting moveSetting
j Start