alias harv d0
alias endSetting d1
alias memoryPosition d2
alias memoryPlant d3
alias memoryHand d4
alias buff r0
alias val r1
alias selectedContainer r2
alias result r3
alias CooEnd r4
alias statePosition r10
alias statePlant r11
alias stateHand r12
# constants
define Hand 0
define Hopper 1
define Tray 255
# devices
define HydroponicsTray 1464854517
#   coordinates
define CooHome 0
define CooUnloader 1
define CooLoader 2
#   positions
define AtHome 0
define AtUnloader 1
define AtLoader 2
define AtField 3
define AtEnd 4
#   state plant
define PlantUndefined 0
define PlantNone 10
define PlantGrowing 20
define PlantMatureSeed 30
define PlantMature 40
define PlantDead 50
#   state item
define ItemEmpty 0
define ItemOccupied 100
define ItemFull 200
# initialization
move result 0
move statePosition 0
move statePlant 0
move stateHand 0

Start:
yield
l CooEnd endSetting Setting
# action only idle
l buff harv Idle
beqz buff SetActive
jal DetermineStatePosition
# determine stateHand
move selectedContainer Hand
jal DetermineStateContainer
move stateHand result
jal DetermineStatePlant
move buff statePosition
add buff buff statePlant
add buff buff stateHand
s db Setting buff
s memoryPosition Setting statePosition
s memoryPlant Setting statePlant
s memoryHand Setting stateHand
j Start

SetActive:
s db Setting -1
j Start

DetermineStatePosition:
move statePosition AtEnd
l val harv Error
bgtzal val ra

l val harv Setting
seq buff val CooEnd
bgtzal buff ra

seq buff val CooHome
select statePosition buff AtHome statePosition
seq buff val CooUnloader
select statePosition buff AtUnloader statePosition
seq buff val CooLoader
select statePosition buff AtLoader statePosition
sltz buff val
select statePosition buff AtField statePosition
j ra

DetermineStateContainer:
move result ItemEmpty
# check if occupied
ls val harv selectedContainer Occupied
select result val ItemOccupied result
beq result ItemEmpty ra
# check if full
ls val harv selectedContainer Quantity
ls buff harv selectedContainer MaxQuantity
seq buff buff val
select result buff ItemFull result
j ra

DetermineStatePlant:
move statePlant PlantUndefined
# if we are not in the field, plant state undefined
l val harv TargetPrefabHash
seq val val HydroponicsTray
beqz val ra

# check if there is plant, exit if not
move statePlant PlantNone
ls val harv Tray Occupied
beqz val ra

# check if plant is dead, exit if yes
move statePlant PlantDead
ls val harv Tray Damage
bnez val ra

# check growth, under 6 is growing
move statePlant PlantGrowing
ls val harv Tray Growth
blt val 6 ra

ls val harv Tray Seeding
select statePlant val PlantMatureSeed PlantMature
j ra