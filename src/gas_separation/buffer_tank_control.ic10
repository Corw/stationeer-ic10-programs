# device types
define gasSensor -1252983604
define memory -851746783
define valve -1280984102
# devices
define valveFillFirst HASH("Tank 1 Fill Valve")
define valveFillSecond HASH("Tank 2 Fill Valve")
define memoryAvailability HASH("Memory Buffer Availability")
# values
define maxPressure 49000
define criticalPressure 50000
# states of tank
define TankEmpty   0
define TankPartial 3
define TankMaxed   6
define TankCritical 9 # valve or control failure
# states of valves
define ValvesClosed 0
define ValvesFilling 1
define ValvesDraining 2
define ValvesError 3
# state of buffer system
define BufferReady    0
define BufferDrained  2
define BufferDraining 5
define BufferFilled   7
define BufferFilling  4
define BufferFull     6
# states of buffer system with both tanks
define Unavailable 0
define Available 1
# variables
alias reading r0
alias stateTank r1
alias stateValves r2
alias stateBuffer1 r3
alias stateBuffer2 r4
alias value r5
alias current r6 # current buffer
alias activeTank r7
# initialization
move current 0
move stateBuffer1 -1
move stateBuffer2 -1
Start:
yield
beq current 0 FirstTankCheck
beq current 1 SecondTankCheck
FirstTankCheck:
# devices
define tankSensor HASH("Tank 1 Analyzer")
define valveFill valveFillFirst
define valveDrain HASH("Tank 1 Drain Valve")
alias stateBuffer r3
alias otherBuffer r4
j Checks
SecondTankCheck:
# devices
define tankSensor HASH("Tank 2 Analyzer")
define valveFill valveFillSecond
define valveDrain HASH("Tank 2 Drain Valve")
alias stateBuffer r4
alias otherBuffer r3
j Checks
Checks:
# determine state of pressure
lbn reading gasSensor tankSensor Pressure Average
move stateTank TankPartial
seq value reading 0
select stateTank value TankEmpty stateTank
sge value reading maxPressure
select stateTank value TankMaxed stateTank
sge value reading criticalPressure
select stateTank value TankCritical stateTank
# determine state of valves
lbn reading valve valveDrain On Average
mul value reading 2
lbn reading valve valveFill On Average
add stateValves value reading
# valve error handling
beq stateValves ValvesError ValvesClose
# determine state of buffer system
add stateBuffer stateTank stateValves
# correction for partial and closed
seq value stateBuffer 3
select stateBuffer value BufferReady stateBuffer

beq stateBuffer BufferDrained OnDrained
beq stateBuffer BufferFilled OnFilled
# cycling trough tanks
add current current 1
blt current 2 Start
move current 0
# we have states of both tanks and valves sets
add value stateBuffer1 stateBuffer2
beqz value OpenFirstTank
seq value value 12 # check both tanks are full
sbn memory memoryAvailability Setting value
j Start

ValvesClose:
sbn valve valveFill On 0
sbn valve valveDrain On 0
j Start

OnDrained:
# close drain valve and if other tank is not filling, start filling
sbn valve valveDrain On 0
beq otherBuffer BufferFilling Start
sbn valve valveFill On 1
j Start

OnFilled:
# close fill valve and if other tank is ready, fill it
sbn valve valveFill On 0
bne otherBuffer BufferReady Start
beq current 0 OpenSecondTank
beq current 1 OpenFirstTank 
j Start

OpenFirstTank:
sbn valve valveFillFirst On 1
j Start

OpenSecondTank:
sbn valve valveFillSecond On 1
j Start
