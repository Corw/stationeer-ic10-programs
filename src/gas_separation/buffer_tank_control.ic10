define memory -851746783
define alarm -2107840748
define memoryAvailability HASH("Memory Buffer Availability")
define alarmCritical HASH("Overpressure Alarm")
# values
define maxPressure 48000
define criticalPressure 50000
# states of tank
define TankEmpty   0
define TankPartial 3
define TankMaxed   6
define TankCritical 9 # valve or control failure
# states of valves
define ValvesClosed 0
define ValvesFilling 1
define ValvesDraining 2
define ValvesError 3
# state of buffer system
define BufferReady    0
define BufferDrained  2
define BufferDraining 5
define BufferFilled   7
define BufferFilling  4
define BufferFull     6
# variables
alias reading r0
alias stateTank r1
alias stateValves r2
alias stateBuffer1 r3
alias stateBuffer2 r4
alias value r5
alias current r6 # current buffer
alias activeTank r7
# initialization
move current 0
move stateBuffer1 -1
move stateBuffer2 -1
sbn alarm alarmCritical On 0
lbn r10 -1280984102 HASH("Tank 1 Fill Valve") ReferenceId Maximum
lbn r11 -1280984102 HASH("Tank 2 Fill Valve") ReferenceId Maximum
lbn r12 -1280984102 HASH("Tank 1 Drain Valve") ReferenceId Maximum
lbn r13 -1280984102 HASH("Tank 2 Drain Valve") ReferenceId Maximum
lbn r14 435685051 HASH("Tank 1 Analyzer") ReferenceId Maximum
lbn r15 435685051 HASH("Tank 2 Analyzer") ReferenceId Maximum
Start:
yield
beq current 0 FirstTankCheck
beq current 1 SecondTankCheck
FirstTankCheck:
alias tankSensor r14
alias valveFill r10
alias valveDrain r12
alias stateBuffer r3
alias otherBuffer r4
j Checks
SecondTankCheck:
alias tankSensor r15
alias valveFill r11
alias valveDrain r13
alias stateBuffer r4
alias otherBuffer r3
j Checks
Checks:
# determine state of pressure
l reading tankSensor Pressure
move stateTank TankPartial
seq value reading 0
select stateTank value TankEmpty stateTank
sge value reading maxPressure
select stateTank value TankMaxed stateTank
sge value reading criticalPressure
select stateTank value TankCritical stateTank
# determine state of valves
l reading valveDrain On
mul value reading 2
l reading valveFill On
add stateValves value reading
beq stateValves ValvesError ValvesClose # valve error handling
beq stateTank TankCritical OnTankCritical
add stateBuffer stateTank stateValves # determine state of buffer system
seq value stateBuffer 3 # correction for partial and closed
select stateBuffer value BufferReady stateBuffer

beq stateBuffer BufferDrained OnDrained
beq stateBuffer BufferFilled OnFilled
# cycling trough tanks
add current current 1
blt current 2 Start
move current 0
# we have states of both tanks and valves sets
add value stateBuffer1 stateBuffer2
beqz value OpenFirstTank
seq value stateBuffer1 BufferFilling
seq reading stateBuffer2 BufferFilling
or value value reading
sbn memory memoryAvailability Setting value
mul value stateBuffer2 10
add value stateBuffer1 value
s db Setting value 
j Start

ValvesClose:
s  valveFill On 0
s  valveDrain On 0
j Start
OnDrained:
# close drain valve and if other tank is not filling, start filling
s  valveDrain On 0
beq otherBuffer BufferFilling Start
s  valveFill On 1
j Start
OnFilled:
# close fill valve and if other tank is ready, fill it
s  valveFill On 0
bne otherBuffer BufferReady Start
beq current 0 OpenSecondTank
beq current 1 OpenFirstTank 
j Start
OpenFirstTank:
sb r10 On 1
j Start
OpenSecondTank:
sb r11 On 1
j Start
OnTankCritical:
sbn alarm alarmCritical On 1
j Start