
# device types
define gasSensor -1252983604
define memory -851746783
define valve -1280984102

# values
define maxPressure 49000
define criticalPressure 50000

# states of tank
define TankEmpty   0
define TankPartial 3
define TankMaxed   6
define TankCritical 9 # valve or control failure

# states of valves
define ValvesClosed 0
define ValvesFilling 1
define ValvesDraining 2
define ValvesError 3

# state of buffer system
define BufferReady    0
define BufferDrained  2
define BufferDraining 5
define BufferFilled   7
define BufferFilling  4
define BufferFull     6


# variables
alias reading r0

alias stateTank r1
alias stateValves r2

alias stateBuffer1 r3
alias stateBuffer2 r4

alias value r5
alias counter r6
alias activeTank r7

move counter 0
move activeTank 0

Start:
yield

beq counter 0 FirstTankCheck
beq counter 1 SecondTankCheck

FirstTankCheck:
# devices
define tankSensor HASH("Tank 1 Analyzer")
define valveFill HASH("Tank 1 Fill Valve")
define valveDrain HASH("Tank 1 Drain Valve")
alias stateBuffer r3
j Checks

SecondTankCheck:
# devices
define tankSensor HASH("Tank 2 Analyzer")
define valveFill HASH("Tank 2 Fill Valve")
define valveDrain HASH("Tank 2 Drain Valve")
alias stateBuffer r4
j Checks

Checks:

# determine state of pressure
lbn reading gasSensor tankSensor Pressure Average
move stateTank TankPartial
seq value reading 0
select stateTank value TankEmpty stateTank
sge value reading maxPressure
select stateTank value TankMaxed stateTank
sge value reading criticalPressure
select stateTank value TankCritical stateTank

# determine state of valves
lbn reading valve valveDrain On Average
mul value reading 2
lbn reading valve valveFill On Average
add stateValves value reading

# valve error handling
beq stateValves ValvesError ValvesClose

# determine state of buffer system
add stateBuffer stateTank stateValves

# correction for partial and closed
seq value stateBuffer 3
select stateBuffer value BufferReady stateBuffer

beq stateBuffer BufferDrained ValvesClose
beq stateBuffer BufferFilled ValvesClose

# cycling trough tanks
add counter counter 1
blt counter 2 Start
move counter 0
# we have states of both tanks and valves sets

j Start

ValvesClose:
sbn valve valveFill On 0
sbn valve valveDrain On 0
j Start
