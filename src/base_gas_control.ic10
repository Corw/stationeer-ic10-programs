alias buff r0
alias logicType r1
alias dispHash r2
alias requiredCO2 r3
alias requiredN r4
alias requiredTemp r5
alias requiredPres r6
alias delta r5
# constants
define Kelvin 273.15
# device types
define disp -2041948072
define gasSensor -1252983604
define btn 1462769197
# devices
define baseGasSensor HASH("Base Gas Sensor")
define dispO2 HASH("Display O2")
define dispVol HASH("Display Vol")
define dispCO2 HASH("Display CO2")
define dispN HASH("Display N")
define dispTemperature HASH("Display Temperature")
define disprequiredTemp HASH("Display Required Temperature")
define dispPressure HASH("Display Pressure")
define disprequiredPres HASH("Display Required Pressure")
define dispRequiredCO2 HASH("Display Required CO2")
define dispRequiredN HASH("Display Required N")
define btnDecreaseCO2 HASH("Button Decrease CO2")
define btnIncreaseCO2 HASH("Button Increase CO2")
define btnDecreaseN HASH("Button Decrease N")
define btnIncreaseN HASH("Button Increase N")
define btnIncreaseTemperature HASH("Button Increase Temperature")
define btnDecreaseTemperature HASH("Button Decrease Temperature")
define btnIncreasePressure HASH("Button Increase Pressure")
define btnDecreasePressure HASH("Button Decrease Pressure")
# initialization disp modes
sbn disp dispO2 Mode DisplayMode.Percent
sbn disp dispVol Mode DisplayMode.Percent
sbn disp dispCO2 Mode DisplayMode.Percent
sbn disp dispN Mode DisplayMode.Percent
sbn disp dispRequiredCO2 Mode DisplayMode.Percent
sbn disp dispRequiredN Mode DisplayMode.Percent
sbn disp dispTemperature Mode DisplayMode.Celsius
sbn disp dispPressure Mode DisplayMode.Pa
sbn disp disprequiredTemp Mode DisplayMode.Celsius
sbn disp disprequiredPres Mode DisplayMode.Pa
# initialization required values to current values
lbn buff gasSensor baseGasSensor RatioNitrogen Average
floor requiredCO2 buff
lbn buff gasSensor baseGasSensor RatioCarbonDioxide Average
floor requiredN buff
lbn buff gasSensor baseGasSensor Temperature Average
floor requiredTemp buff
lbn buff gasSensor baseGasSensor Pressure Average
floor requiredPres buff
Start:
yield
lbn buff gasSensor baseGasSensor RatioOxygen Average
sbn disp dispO2 Setting buff
lbn buff gasSensor baseGasSensor RatioNitrogen Average
sbn disp dispN Setting buff
lbn buff gasSensor baseGasSensor RatioCarbonDioxide Average
sbn disp dispCO2 Setting buff
lbn buff gasSensor baseGasSensor RatioVolatiles Average
sbn disp dispVol Setting buff
lbn buff gasSensor baseGasSensor Temperature Average
sub buff buff Kelvin
sbn disp dispTemperature Setting buff
lbn buff gasSensor baseGasSensor Pressure Average
sbn disp dispPressure Setting buff

lbn buff btn btnDecreaseCO2 Activate Average
select delta buff -0.01 0 
add requiredCO2 requiredCO2 delta
sbn disp dispRequiredCO2 Setting requiredCO2

lbn buff btn btnIncreaseCO2 Activate Average
select delta buff 0.01 0 
add requiredCO2 requiredCO2 delta
sbn disp dispRequiredCO2 Setting requiredCO2  

lbn buff btn btnDecreaseN Activate Average
select delta buff -0.01 0
add requiredN requiredN delta
sbn disp dispRequiredN Setting requiredN

lbn buff btn btnIncreaseN Activate Average
select delta buff 0.01 0
add requiredN requiredN delta
sbn disp dispRequiredN Setting requiredN

lbn buff btn btnIncreaseTemperature Activate Average
select delta buff 1 0
add requiredTemp requiredTemp delta
sbn disp disprequiredTemp Setting requiredTemp

lbn buff btn btnDecreaseTemperature Activate Average
select delta buff -1 0
add requiredTemp requiredTemp delta
sbn disp disprequiredTemp Setting requiredTemp

lbn buff btn btnIncreasePressure Activate Average
select delta buff 1000 0
add requiredPres requiredPres delta
sbn disp disprequiredPres Setting requiredPres
j Start