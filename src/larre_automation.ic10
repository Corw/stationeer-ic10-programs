alias harv d0
alias state d1
alias buff r0
alias val r1
alias reqPlantState r5
alias program r10
alias stateHand r11
alias statePosition r12
alias statePlant r13
# constants
#   coordinates
define CooHome 0
define CooUnloader 1
#   programs
define ProgHarvestSeed 0
define ProgHarvestPlant 1
define ProgSeed 2
#   positions
define AtHome 0
define AtUnloader 1
define AtField 2
define AtEnd 3
#   state plant
define PlantNone 10
define PlantGrowing 20
define PlantMatureSeed 30
define PlantMature 40
define PlantDead 50
#   state item
define ItemEmpty 0
define ItemOccupied 100
define ItemFull 200
# intitialization
move program ProgHarvestSeed
Start:
yield
# action only idle
l buff state Setting
bltz buff Start
jal DetermineState
beq program ProgHarvestSeed ProgramHarvestSeed
beq program ProgHarvestPlant ProgramHarvestPlant
j Start

DetermineState:
mod val buff 10
move statePosition val
sub buff buff val

mod val buff 100
move statePlant val
sub buff buff val

mod val buff 1000
move stateHand val

j ra

# programs
ProgramHarvestSeed:
move reqPlantState PlantMatureSeed
j ProgramHarvest

ProgramHarvestPlant:
move reqPlantState PlantMature
j ProgramHarvest

ProgramHarvest:
beq statePosition AtHome DoStep
beq statePosition AtField DoHarvest
beq statePosition AtUnloader DoUnload
beq statePosition AtEnd DoEnd
j Start
# actions
DoStep:
l val harv Setting
sub val val 1
s harv Setting val
j Start

DoGoHome:
s harv Setting CooHome
j Start

DoActivate:
s harv Activate 1
j Start

DoHarvest:
beq stateHand ItemFull DoGoUnload
bne statePlant reqPlantState DoStep
j DoActivate

DoGoUnload:
s harv Setting CooUnloader
j Start

DoUnload:
beq stateHand ItemEmpty DoGoHome
j DoActivate

DoEnd:
# move to next program
add program program 1
sgt buff program ProgHarvestPlant
select program buff ProgHarvestSeed program

beq stateHand ItemOccupied DoGoUnload
beq stateHand ItemFull DoGoUnload
beq stateHand ItemEmpty DoGoHome