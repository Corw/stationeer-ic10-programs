alias dish r0
alias buffer r1

# device types
define switch 1773255945
define display2 -2041948072
define display3 -246585138
define diode 1311586884

# devices 
define selector HASH("Selector Switch")
define displayHorizontalActual HASH("Horizontal Actual")
define displayVerticalActual HASH("Vertical Actual")
define diodeActive HASH("Dish Active")
define displayPower HASH("Power")
define displayError HASH("Error")
define displayActivate HASH("Activate")
define displaySetting HASH("Setting")
define displayRequiredPower HASH("RequiredPower")
define displayIdle HASH("Idle")
define displaySignalStrength HASH("SignalStrength")
define displaySignalId HASH("SignalId")
define displayInterrogationProgress HASH("InterrogationProgress")
define displaySizeX HASH("SizeX")
define displaySizeY HASH("SizeY")

# constants
define ModeDegrees 16
define ModeString 10

# set display modes to degrees
sbn display3 displayHorizontalActual Mode ModeDegrees
sbn display3 displayVerticalActual Mode ModeDegrees
sbn display3 displaySignalId Mode ModeString


Start:
s db Setting Start
yield

lbn dish switch selector Setting Average

l buffer dr0 Horizontal
sbn display2 displayHorizontalActual Setting buffer
l buffer dr0 Vertical
sbn display2 displayVerticalActual Setting buffer

l buffer dr0 Idle
select buffer buffer DiodeOff DiodeBlink
jal buffer
jal DebugDisplays
j Start

DiodeOff:
s db Setting DiodeOff

sbn diode diodeActive Color Color.Black
j ra

DiodeBlink:
s db Setting DiodeBlink
lbn buffer diode diodeActive Color Average
# check if value in buffer is equal to Color.Black
beq buffer Color.Red DiodeOff
sbn diode diodeActive Color Color.Red
j ra


DebugDisplays:
s db Setting DebugDisplays

l buffer dr0 Power
sbn display3 displayPower Setting buffer
l buffer dr0 Error
sbn display3 displayError Setting buffer
l buffer dr0 Activate
sbn display3 displayActivate Setting buffer
l buffer dr0 Setting
sbn display3 displaySetting Setting buffer
l buffer dr0 RequiredPower
sbn display3 displayRequiredPower Setting buffer
l buffer dr0 Idle
sbn display3 displayIdle Setting buffer
l buffer dr0 SignalStrength
sbn display3 displaySignalStrength Setting buffer
l buffer dr0 SignalID
sbn display3 displaySignalId Setting buffer
l buffer dr0 InterrogationProgress
sbn display3 displayInterrogationProgress Setting buffer
l buffer dr0 SizeX
sbn display3 displaySizeX Setting buffer
l buffer dr0 SizeZ
sbn display3 displaySizeY Setting buffer
j ra