define export 1957571043
define target 255
alias hand d0
alias value r15
alias position r14
alias index r13
j move_home
start:
yield
move index 0
s hand TargetSlotIndex index
lb value export Open Maximum
beqz value start
move position 0
# move to first open chute
move_loop:
  sub position position 1
  s hand Setting position
  jal wait_idle
  ls value hand target Occupied
  beqz value move_loop
# take from chute and move to storage
s hand Activate 1
jal wait_idle
mul position position -1
s hand Setting position
jal wait_idle
move index 0
ls value hand target FreeSlots
bgtz value slot_loop
# empty hand if container full
s hand Setting -1
jal wait_idle
s hand Activate 1
jal wait_idle
j move_home
# find free slot
slot_loop:
  s hand TargetSlotIndex index
  ls value hand target Occupied
  breqz value 3
  add index index 1
  j slot_loop
# drop into free slot
s hand Activate 1
jal wait_idle
# move home
move_home:
s hand Setting 0
jal wait_idle
j start
wait_idle:
  yield
  l value hand Idle
  beqz value wait_idle
  j ra
  