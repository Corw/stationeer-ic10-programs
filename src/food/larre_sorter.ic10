define export 1957571043
define target 255
define max_index 14
alias hand d0
alias chute d1
alias value r15
alias position r14
alias index r13
j move_home
start:
yield
# empty chute
ls value chute 0 Occupied
select value value 0 1
s chute Open value
move index 0
s hand TargetSlotIndex index
lb value export Open Maximum
beqz value start
move position 0
# move to first open chute
move_loop:
  sub position position 1
  s hand Setting position
  jal wait_idle
  ls value hand target Occupied
  beqz value move_loop
# take from chute and move to storage
s hand Activate 1
jal wait_idle
mul position position -1
s hand Setting position
jal wait_idle
# find free slot
slot_loop:
  s hand TargetSlotIndex index
  ls value hand target Occupied
  beqz value empty_hand
  add index index 1
  ble index max_index slot_loop
  s hand Setting -1
  jal wait_idle  
empty_hand:
s hand Activate 1
jal wait_idle
# move home
move_home:
s hand Setting 0
jal wait_idle
j start
wait_idle:
  yield
  l value hand Idle
  beqz value wait_idle
  j ra
  