{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "ic10",
      "request": "launch",
      "name": "Debug ic10",
      "program": "${file}",
      "stopOnEntry": true,
      "trace": false
    },
    {
      "name": "Python: Run import.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/import.py",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "Python: Run create_empty_config.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/create_empty_config.py",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "Python: Run export.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/export.py",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    }    
  ]
}